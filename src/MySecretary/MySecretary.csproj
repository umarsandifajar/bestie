<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MySecretary</AssemblyName>
    <RootNamespace>MySecretary</RootNamespace>

    <!-- Versi & metadata -->
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>bestie</Product>
    <Description>bestie - asisten desktop Windows: jam notch, pengingat sholat, reminder, to do, dan alat file.</Description>
    <Copyright>Copyright (c) 2026 sandiana.my.id</Copyright>
    <RepositoryType>git</RepositoryType>

    <!-- Aman untuk single-file (SkiaSharp memakai native library) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\**\*.ttf" />
    <Resource Include="Fonts\**\*.otf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="PDFsharp-wpf" Version="6.1.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>
</Project>
