<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Nilai awal (Black). Pal.cs menimpa semuanya saat tema diganti; semua style di bawah memakai DynamicResource. -->
  <SolidColorBrush x:Key="Ink" Color="#F3F3F5"/>
  <SolidColorBrush x:Key="Dim" Color="#8E8E96"/>
  <SolidColorBrush x:Key="Fill" Color="#18181B"/>
  <SolidColorBrush x:Key="FillHover" Color="#222226"/>
  <SolidColorBrush x:Key="Line" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="Accent" Color="#F3F3F5"/>
  <SolidColorBrush x:Key="AccentInk" Color="#0B0B0C"/>
  <SolidColorBrush x:Key="Win" Color="#121215"/>
  <SolidColorBrush x:Key="Pop" Color="#0C0C0E"/>
  <SolidColorBrush x:Key="Sel" Color="#2A2A30"/>
  <SolidColorBrush x:Key="Track" Color="#2A2A30"/>
  <SolidColorBrush x:Key="Cyan" Color="#22D3EE"/>
  <SolidColorBrush x:Key="Violet" Color="#A78BFA"/>
  <FontFamily x:Key="Sf">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Warna teks diwariskan dari root jendela (TextElement.Foreground), bukan dari style ini -->
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Sf}"/></Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="12,5"/><Setter Property="Background" Value="{DynamicResource Fill}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="FontFamily" Value="{StaticResource Sf}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value=".82"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".6"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".35"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Tag" Value="primary">
      <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Trigger></Style.Triggers>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Fill}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Dim}"/><Setter Property="SelectionOpacity" Value=".4"/>
    <Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontFamily" Value="{StaticResource Sf}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="bd" CornerRadius="6" Padding="8,6" Margin="0,1" Background="Transparent"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource FillHover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Sel}"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent">
      <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Dim}" Opacity=".45" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid>
      <Border Background="{DynamicResource Track}" CornerRadius="2"/><Border x:Name="PART_Track"/>
      <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left"/>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="Seg" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="b" CornerRadius="6" Padding="14,4" Background="Transparent"><ContentPresenter HorizontalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Sel}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Toggle ala Windows 11: hitam/putih sesuai tema -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal" Background="Transparent">
        <Border x:Name="tr" Width="38" Height="20" CornerRadius="10" Background="{DynamicResource Fill}" BorderBrush="{DynamicResource Dim}" BorderThickness="1">
          <Ellipse x:Name="kn" Width="10" Height="10" Fill="{DynamicResource Dim}" HorizontalAlignment="Left" Margin="4,0,0,0"/>
        </Border>
        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
        <Setter TargetName="tr" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="tr" Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter TargetName="kn" Property="Fill" Value="{DynamicResource AccentInk}"/><Setter TargetName="kn" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="kn" Property="Margin" Value="0,0,4,0"/>
      </Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Background="{DynamicResource Pop}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="9,4" TextElement.Foreground="{DynamicResource Ink}"><ContentPresenter/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Background="{DynamicResource Pop}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="4"><StackPanel IsItemsHost="True"/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="b" CornerRadius="5" Padding="8,6,16,6" Background="Transparent">
        <StackPanel Orientation="Horizontal"><TextBlock x:Name="ck" Text="✓" Width="20" Visibility="Hidden" Foreground="{DynamicResource Ink}"/><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ck" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource FillHover}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
